// Kasma database schema (Prisma 6, PostgreSQL).
//
// Models are added incrementally across Phase 1:
//   1.2 tenant · 1.3 banking · 1.4 ledger · 1.5 evidence · 1.6 controls
// Money is always stored as integer minor units + an ISO currency code.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy (Phase 1.2)
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  ADMIN
  ACCOUNTANT
  VIEWER
}

/// A person. May belong to multiple organizations via Membership.
/// Fields are Auth.js-adapter compatible; `passwordHash` backs credentials auth.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships       Membership[]
  attachments       Attachment[]
  notes             Note[]
  transactionEvents TransactionEvent[]
}

/// A tenant. Every business record hangs off an organization.
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships       Membership[]
  bankAccounts      BankAccount[]
  statements        Statement[]
  importJobs        ImportJob[]
  categories        Category[]
  transactions      Transaction[]
  attachments       Attachment[]
  notes             Note[]
  transactionEvents TransactionEvent[]
}

/// Join between a User and an Organization, carrying the user's role there.
model Membership {
  id             String   @id @default(cuid())
  role           Role     @default(VIEWER)
  userId         String
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Banking (Phase 1.3)
// ---------------------------------------------------------------------------

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  LOAN
  OTHER
}

enum StatementStatus {
  UPLOADED
  QUEUED
  PARSING
  PARSED
  NEEDS_REVIEW
  CONFIRMED
  FAILED
}

enum StatementSource {
  UPLOAD
}

enum ImportJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

/// A single company bank account. Balances are integer minor units.
model BankAccount {
  id             String      @id @default(cuid())
  organizationId String
  bankName       String
  accountName    String
  /// Last 4 digits only — full account numbers are never stored.
  last4          String?
  /// ISO 4217 currency code, e.g. "USD".
  currency       String
  type           AccountType @default(CHECKING)
  /// Opening balance in minor units (e.g. cents).
  openingBalance BigInt      @default(0)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  statements   Statement[]
  transactions Transaction[]

  @@index([organizationId])
}

/// An uploaded bank statement and the metadata extracted from it. The
/// opening/closing balances are the reconciliation oracle for its period.
model Statement {
  id               String          @id @default(cuid())
  organizationId   String
  bankAccountId    String
  periodStart      DateTime?
  periodEnd        DateTime?
  openingBalance   BigInt?
  closingBalance   BigInt?
  currency         String?
  status           StatementStatus @default(UPLOADED)
  source           StatementSource @default(UPLOAD)
  /// Object-storage key for the uploaded file.
  fileKey          String?
  originalFilename String?
  /// SHA-256 of the file for dedupe + extraction caching.
  fileHash         String?
  /// Which parser produced the result (csv/xlsx/pdf/claude).
  parserUsed       String?
  confidence       Float?
  /// Object-storage key for the raw extractor response (LLM audit trail).
  rawExtractionKey String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankAccount  BankAccount   @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  importJobs   ImportJob[]
  transactions Transaction[]
  attachments  Attachment[]

  @@index([organizationId])
  @@index([bankAccountId])
  @@index([fileHash])
}

/// A background parsing job for a statement (processed by the pg-boss worker).
model ImportJob {
  id             String          @id @default(cuid())
  organizationId String
  statementId    String
  status         ImportJobStatus @default(QUEUED)
  attempts       Int             @default(0)
  error          String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  statement    Statement    @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([statementId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Ledger (Phase 1.4)
// ---------------------------------------------------------------------------

enum TxnDirection {
  CREDIT
  DEBIT
}

enum TxnType {
  CREDIT
  DEBIT
  CHARGE
  FEE
  PAYMENT
  TRANSFER
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
  DISPUTED
}

/// User-defined transaction category (org-scoped).
model Category {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  color          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// A single ledger entry, normalized from a statement row. `amount` is signed
/// minor units (positive = credit, negative = debit); `runningBalance` is the
/// statement's post-transaction balance used for reconciliation.
model Transaction {
  id                 String             @id @default(cuid())
  organizationId     String
  bankAccountId      String
  statementId        String?
  date               DateTime
  valueDate          DateTime?
  description        String
  rawDescription     String?
  amount             BigInt
  direction          TxnDirection
  type               TxnType            @default(DEBIT)
  runningBalance     BigInt?
  currency           String
  counterparty       String?
  reference          String?
  categoryId         String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  /// sha256(account|isoDate|signedMinorAmount|normalizedDesc|reference).
  dedupeHash         String
  isDuplicate        Boolean            @default(false)
  isInternalTransfer Boolean            @default(false)
  /// Soft reference to the matched counterpart transaction (set by the
  /// reconciliation engine); not an FK to keep the pairing update simple.
  matchedTransferId  String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankAccount  BankAccount  @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  statement    Statement?   @relation(fields: [statementId], references: [id], onDelete: SetNull)
  category     Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  attachments  Attachment[]
  notes        Note[]
  events       TransactionEvent[]

  @@unique([organizationId, dedupeHash])
  @@index([organizationId])
  @@index([bankAccountId])
  @@index([statementId])
  @@index([categoryId])
  @@index([matchedTransferId])
  @@index([date])
}

// ---------------------------------------------------------------------------
// Evidence & verification (Phase 1.5)
// ---------------------------------------------------------------------------

enum AttachmentKind {
  RECEIPT
  INVOICE
  DOCUMENT
  NOTE
}

enum TransactionEventKind {
  CREATED
  EDITED
  CATEGORIZED
  EVIDENCE_ADDED
  VERIFIED
  MATCHED
  NOTE
}

/// A supporting file attached to a transaction or statement.
model Attachment {
  id               String         @id @default(cuid())
  organizationId   String
  transactionId    String?
  statementId      String?
  kind             AttachmentKind @default(DOCUMENT)
  fileKey          String
  originalFilename String?
  contentType      String?
  size             Int?
  uploadedById     String?
  createdAt        DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transaction  Transaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  statement    Statement?   @relation(fields: [statementId], references: [id], onDelete: Cascade)
  uploadedBy   User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([transactionId])
  @@index([statementId])
}

/// A free-text note/comment on a transaction.
model Note {
  id             String   @id @default(cuid())
  organizationId String
  transactionId  String
  authorId       String?
  body           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transaction  Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  author       User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([transactionId])
}

/// Append-only timeline entry for a transaction (audit log). Never updated.
model TransactionEvent {
  id             String               @id @default(cuid())
  organizationId String
  transactionId  String
  actorId        String?
  kind           TransactionEventKind
  payload        Json?
  createdAt      DateTime             @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transaction  Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([transactionId])
  @@index([createdAt])
}
