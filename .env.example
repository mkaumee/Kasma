# Copy this file to `.env` (or `.env.local`) and fill in values as you enable
# each part of the app. Everything except the app URL is optional until the
# corresponding feature is wired up.

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Database (PostgreSQL) ---
# Local dev via docker-compose (see prisma/ and docker-compose.yml).
DATABASE_URL="postgresql://kasma:kasma@localhost:5432/kasma?schema=public"

# --- Auth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# --- Object storage ---
# STORAGE_DRIVER: "s3" (object storage), "db" (store files in Postgres — no
# external bucket, good for single-database deploys), or unset for local disk.
# STORAGE_DRIVER="db"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET="kasma-dev"

# --- Statement extraction (LLM fallback) ---
# Fallback extractor for scanned/unknown statements. Without any key the
# pipeline still runs on the deterministic CSV/XLSX/PDF parsers.
#
# Provider preference: "auto" (default) uses DeepSeek when its key is set and
# routes scanned PDFs/images to Claude when available; "deepseek" or "anthropic"
# pin a single provider.
EXTRACTION_PROVIDER="auto"

# DeepSeek: the default fallback provider, text-only (CSV/text + digital
# PDFs). Cheap and OpenAI-compatible. Cannot read scanned PDFs or images.
# NOTE: the legacy `deepseek-chat` / `deepseek-reasoner` IDs were retired on
# 2026-07-24. Current models: deepseek-v4-pro (default) and deepseek-v4-flash
# (cheaper and faster; set DEEPSEEK_MODEL to switch).
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-v4-pro"
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# Anthropic (Claude): optional vision provider for scanned PDFs and images that
# DeepSeek can't read. Leave unset to run the DeepSeek and deterministic
# parsers only.
ANTHROPIC_API_KEY=""
# Cost-efficient model used for per-statement extraction (metered per org).
ANTHROPIC_EXTRACTION_MODEL="claude-sonnet-5"

# Mask likely account/card numbers in text before sending it to any LLM.
LLM_REDACT_PII="true"

# --- Email (Resend) ---
RESEND_API_KEY=""
