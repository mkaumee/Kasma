# Copy this file to `.env` (or `.env.local`) and fill in values as you enable
# each part of the app. Everything except the app URL is optional until the
# corresponding feature is wired up.

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Phase 1: Database (PostgreSQL) ---
# Local dev via docker-compose (see prisma/ and docker-compose.yml).
DATABASE_URL="postgresql://kasma:kasma@localhost:5432/kasma?schema=public"

# --- Phase 2: Auth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# --- Phase 5: Object storage (S3-compatible, e.g. MinIO in dev) ---
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET="kasma-dev"

# --- Phase 6: Statement extraction (Anthropic) ---
ANTHROPIC_API_KEY=""

# --- Phase 12: Email (Resend) ---
RESEND_API_KEY=""
